    "components": {
        "schemas": {
            "LoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "email",
                        "example": "example@gmail.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                "type": "object"
            },
            "RegisterRequest": {
                "required": [
                    "name",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "example"
                    },
                    "email": {
                        "type": "email",
                        "example": "example@gmail.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "123456789"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "example": "123456789"
                    }
                },
                "type": "object"
            },
            "StoreAuthorRequest": {
                "required": [
                    "name",
                    "date_of_birth",
                    "information"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "example"
                    },
                    "date_of_birth": {
                        "type": "string",
                        "format": "date",
                        "example": "2020-2-2"
                    },
                    "information": {
                        "type": "string",
                        "example": "example info."
                    }
                },
                "type": "object"
            },
            "UpdateAuthorRequest": {
                "required": [
                    "name",
                    "date_of_birth",
                    "information"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "example"
                    },
                    "date_of_birth": {
